# Solace Agent Mesh Desktop (the Linux build, run in WSL2: the Windows build's broker mode is experimental) -> this demo's CONUS broker.
#
# The desktop bundle ships its own in-memory broker; this file points it at the real one instead, on the
# same Message VPN and A2A namespace the Docker agents use, so the desktop's Agents page shows IamdAgent,
# ShipDefenseAgent, TargetingAgent, CoalitionLiaisonAgent and CopWatchOfficerAgent next to its own built-in
# agents, and its Orchestrator delegates to them over A2A on the mesh. Nothing in the demo changes.
#
# Install (Ubuntu tab, once; the app reads ~/.config/sam/.env at startup):
#   mkdir -p ~/.config/sam && cp <repo>/mesh/desktop/desktop.env ~/.config/sam/.env
# then: solace-agent-mesh &
#
# Only the five variables the desktop documents. No NAMESPACE: the Desktop keeps its own A2A root,
# solace-agent-mesh/, and the Docker agents are configured to join it (mesh/.env). Its own username (same ACL as the Docker
# host) so its connections are easy to tell apart on Broker Manager's Clients page and never count
# against the Docker host's connection limit. The desktop runs on the Windows host, so
# from WSL "localhost" reaches the conus broker's published SMF port 55555 the same way the Python services do.
# Do not add port or LLM overrides here: the desktop manages its own web ports and its LLM is set in the
# first-launch dialog (Ollama, http://localhost:11434, qwen2.5:7b or 3b).

SOLACE_DEV_MODE=false
SOLACE_BROKER_URL=tcp://localhost:55555
SOLACE_BROKER_VPN=cop
SOLACE_BROKER_USERNAME=agent-mesh-desktop
SOLACE_BROKER_PASSWORD=cop-demo
