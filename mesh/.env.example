# Copy to mesh/.env. Everything has a working default for the Docker setup; this file is for overrides.
NAMESPACE=solace-agent-mesh/    # the Desktop uses this root and cannot be told another; the Docker agents join it
SOLACE_BROKER_URL=ws://conus:8008
SOLACE_BROKER_VPN=cop
SOLACE_BROKER_USERNAME=agent-mesh
SOLACE_BROKER_PASSWORD=cop-demo
# The COP tools' own SMF client (same broker, same user)
COP_SOLACE_HOST=tcp://conus:55555
COP_SOLACE_VPN=cop
COP_SOLACE_USER=agent-mesh
COP_SOLACE_PASSWORD=cop-demo

# LLM: local Ollama in the compose stack (air-gapped). Pull the model once: docker exec solace-ollama ollama pull qwen2.5:3b
LLM_SERVICE_ENDPOINT=http://ollama:11434
LLM_SERVICE_API_KEY=none
LLM_SERVICE_GENERAL_MODEL_NAME=ollama_chat/qwen2.5:3b
LLM_SERVICE_PLANNING_MODEL_NAME=ollama_chat/qwen2.5:3b
# Every agent, the COP Watch Officer behind the Desktop chat included, uses the small, fast model (one tool
# call, short answer: ~20-30 s on the CPU). The 7B gives better prose but is 2-3x slower and a cold 5 GB load
# after every idle period: docker exec solace-ollama ollama pull qwen2.5:7b, then set it here.
# SAM_SLIM_PROMPT=0 restores the runtime's full generic system prompt (~3,500 tokens/call); see docs/agent-mesh.md.
# A hosted model instead (no air gap): any LiteLLM provider, e.g.
#   LLM_SERVICE_ENDPOINT=https://<provider endpoint>  LLM_SERVICE_API_KEY=<key>  LLM_SERVICE_GENERAL_MODEL_NAME=<provider>/<model>

SESSION_SECRET_KEY=cop-demo-session-secret
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
PLATFORM_API_HOST=127.0.0.1
PLATFORM_API_PORT=8001
PLATFORM_SERVICE_URL=http://127.0.0.1:8001
LOGGING_CONFIG_PATH=configs/logging_config.yaml
SAM_AUTHORIZATION_CONFIG={"authorization_service": {"type": "none"}}
PLATFORM_DATABASE_URL=sqlite:////mesh/data/platform.db
WEB_UI_GATEWAY_DATABASE_URL=sqlite:////mesh/data/webui_gateway.db
